#!/usr/bin/env bash
# Back up the Hugging Face hub cache to the NAS over Tailscale.
set -euo pipefail

SRC="${HF_HUB_CACHE:-$HOME/.cache/huggingface/hub}/"
# UGOS's rsync only accepts share-relative paths (not /volume1/...),
# and requires the rsync service enabled in Control Panel → File Services.
DEST="ugreen-nas:Backups/huggingface-hub/"

[ -d "$SRC" ] || { echo "No HF cache at $SRC, skipping"; exit 0; }

# Skip quietly when off the tailnet or the NAS is asleep.
if ! tailscale ping -c 1 --timeout 5s ugreen-nas >/dev/null 2>&1; then
  echo "ugreen-nas unreachable, skipping"
  exit 0
fi

# -a keeps the snapshots/ -> blobs/ relative symlinks (don't use -L).
# No --delete: models removed locally stay on the NAS.
rsync -a --partial --human-readable --info=stats1 \
  --exclude '.locks/' \
  --exclude '*.incomplete' \
  "$SRC" "$DEST"
